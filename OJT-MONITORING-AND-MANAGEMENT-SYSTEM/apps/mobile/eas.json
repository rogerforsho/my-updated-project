{
  "cli": {
    "version": ">= 12.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "preview"
      },
      "environment": "preview",
      "channel": "preview"
    },
    "appetize-ios": {
      "extends": "preview",
      "ios": {
        "simulator": true
      },
      "channel": "appetize-ios"
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production"
      },
      "environment": "production",
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
