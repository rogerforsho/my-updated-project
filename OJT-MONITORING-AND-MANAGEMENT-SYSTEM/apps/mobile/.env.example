# Public configuration only. Never put a service-role key in mobile.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
# Must use the same Supabase project as the mobile app. Rebuild after changing.
EXPO_PUBLIC_WEB_URL=https://YOUR_WEB_PORTAL
