{
  "name": "cross-platform-ojt-system",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "shared",
    "apps/desktop"
  ],
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "@xmldom/xmldom": "^0.8.13",
    "postcss": "^8.5.23",
    "minimatch@^10.0.0": {
      "brace-expansion": "^5.0.12"
    },
    "uuid": "^11.1.1",
    "follow-redirects": "1.16.1",
    "shell-quote": "^1.11.0"
  },
  "scripts": {
    "build": "npm run build:web",
    "typecheck": "npm run typecheck -w apps/web && npm run typecheck -w apps/mobile",
    "dev:web": "npm run dev -w apps/web",
    "dev:mobile": "npm run dev -w apps/mobile",
    "dev:desktop": "concurrently -k \"npm run dev -w apps/web\" \"wait-on http://localhost:3000 && electron apps/desktop\"",
    "build:web": "npm run build -w apps/web",
    "build:desktop": "npm run build -w apps/desktop",
    "test": "node scripts/run-tests.mjs",
    "test:unit": "node scripts/run-tests.mjs unit",
    "test:db": "node scripts/run-tests.mjs db"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "concurrently": "^9.1.2",
    "electron": "^44.7.0",
    "next": "^15.2.4",
    "wait-on": "^8.0.2"
  }
}
