# Local Supabase only. Get current local keys with: npx supabase status
# Use the computer's current Wi-Fi IP for mobile access to the local web portal.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-publishable-or-anon-key
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-secret-or-service-role-key
NEXT_PUBLIC_APP_URL=http://192.168.1.9:3000
OJT_LOCAL_LAN_IP=192.168.1.9
CRON_SECRET=replace-with-a-long-random-value
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Sentry source-map upload credentials are build-only; configure them in CI, not this runtime env file.
